# Modo servidor en la LAN (opcional; el sitio público es estático en GitHub Pages).
# /etc/systemd/system/radar-ofertas.service — requiere usuario «radar» y venv en /opt/radar-ofertas/.venv
[Unit]
Description=Radar de ofertas (LAN)
After=network-online.target
Wants=network-online.target

[Service]
User=radar
Group=radar
WorkingDirectory=/opt/radar-ofertas
StateDirectory=radar-ofertas
Environment=RADAR_SEED=/opt/radar-ofertas/data/seed.json
Environment=RADAR_HISTORY=/opt/radar-ofertas/data/observations.jsonl
Environment=RADAR_IMAGE_DIR=/var/lib/radar-ofertas/images
Environment=RADAR_FETCH_IMAGES=1
Environment=TZ=Europe/Madrid
# Cambie 0.0.0.0 por la IP de la LAN del host para no escuchar en otras interfaces.
ExecStart=/opt/radar-ofertas/.venv/bin/uvicorn --factory radar.web.app:build_from_env --host 0.0.0.0 --port 8080
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
